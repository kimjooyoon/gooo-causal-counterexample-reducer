invariant group=REGRESSION ordinal=11 id=R03 name=no-global-minimum-claim
invariant group=REGRESSION ordinal=12 id=R04 name=runtime-zero-gates

vector name=DRIVER indicators=nodes_removed,edges_removed,evidence_removed,cell_dependencies_removed
vector name=OUTCOME indicators=decision_preserved,priority_preserved,unknown_fields_preserved,witness_preserved
vector name=GUARDRAIL indicators=oracle_calls,wall_ms,peak_rss_kib,repository_writes

